# ============================================
# Variáveis de ambiente do Rank Farm
# Copie este arquivo para .env.local e preencha com seus valores
# ============================================

# --- Supabase (PostgreSQL) ---
# URL do projeto Supabase (ex: https://xyzcompany.supabase.co)
NEXT_PUBLIC_SUPABASE_URL=https://seu-projeto.supabase.co

# Chave pública anon (do Supabase Dashboard > Settings > API)
NEXT_PUBLIC_SUPABASE_ANON_KEY=sua-chave-anon-aqui

# Chave service role (do Supabase Dashboard > Settings > API) - usada apenas no servidor
SUPABASE_SERVICE_ROLE_KEY=sua-chave-service-role-aqui

# --- JWT ---
# Configure uma chave aleatória forte, diferente deste arquivo de exemplo.
JWT_SECRET=

# --- Limpeza diária das sessões vencidas na Vercel ---
# Gere um segredo aleatório e cadastre o mesmo valor no ambiente Production da Vercel.
CRON_SECRET=

# --- Cloudinary (upload de fotos de perfil) ---
CLOUDINARY_CLOUD_NAME=seu-cloud-name
CLOUDINARY_API_KEY=sua-api-key
CLOUDINARY_API_SECRET=sua-api-secret
